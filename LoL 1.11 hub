-- ============================================================
--  UNLOCK ALL SKINS
-- ============================================================
local function ToggleSkinUnlock(state)
    SkinUnlockEnabled = state
    -- Method 1: PlayerData BoolValues
    pcall(function()
        local data = LocalPlayer:FindFirstChild("PlayerData")
                  or LocalPlayer:FindFirstChild("Data")
                  or LocalPlayer:FindFirstChild("leaderstats")
        if data then
            for _, v in ipairs(data:GetDescendants()) do
                if v:IsA("BoolValue") and
                   (v.Name:lower():find("own") or v.Name:lower():find("unlock") or v.Name:lower():find("have") or v.Name:lower():find("skin")) then
                    v.Value = state
                end
            end
        end
    end)
    -- Method 2: getgc scan (executor-only bonus)
    pcall(function()
        if getgc then
            for _, v in ipairs(getgc(true)) do
                if type(v) == "table" and rawget(v, "OwnedSkins") then
                    v.OwnedSkins = setmetatable({}, {__index = function() return true end})
                end
            end
        end
    end)
end

