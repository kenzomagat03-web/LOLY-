-- Helper: Get Target RootPart securely by exact parsing
local function getTargetRoot(myRoot)
   if selectedTargetSelection and selectedTargetSelection ~= "None (Nearest)" then
      for _, p in ipairs(Players:GetPlayers()) do
         if p ~= LocalPlayer then
            local formattedName = string.format("%s (%s)", p.Name, p.DisplayName)
            if formattedName == selectedTargetSelection or p.Name == selectedTargetSelection then
               if p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                  local hum = p.Character:FindFirstChild("Humanoid")
                  if hum and hum.Health > 0 then
                     return p.Character.HumanoidRootPart
                  end
               end
               return nil
            end
         end
      end
      return nil
   end

   -- Fallback: Nearest Player
   local nearestDist = math.huge
   local bestRoot = nil
   for _, p in ipairs(Players:GetPlayers()) do
      if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
         local hum = p.Character:FindFirstChild("Humanoid")
         if hum and hum.Health > 0 then
            local dist = (myRoot.Position - p.Character.HumanoidRootPart.Position).Magnitude
            if dist < nearestDist then
               nearestDist = dist
               bestRoot = p.Character.HumanoidRootPart
            end
         end
      end
   end
   return bestRoot
end

-- Helper: Find Safest Void
local function getSafestVoidPosition(targetRootPos)
   local furthestPos = LocalPlayer.Character.HumanoidRootPart.Position
   local maxDist = 0
   
   for _, obj in ipairs(workspace:GetChildren()) do
      if obj:IsA("BasePart") then
         local dist = (obj.Position - targetRootPos).Magnitude
         if dist > maxDist then
            maxDist = dist
            furthestPos = obj.Position + Vector3.new(0, 5, 0)
         end
      end
   end
   return furthestPos
end

-- Helper: Force 100% Hit Connection
local function forceHitTarget(targetRoot)
   if not targetRoot or not LocalPlayer.Character then return end
   local myChar = LocalPlayer.Character
   
   for _, tool in ipairs(myChar:GetChildren()) do
      if tool:IsA("Tool") then
         tool:Activate()
         for _, part in ipairs(tool:GetDescendants()) do
            if part:IsA("BasePart") then
               part.CFrame = targetRoot.CFrame
               if firetouchinterest then
                  firetouchinterest(part, targetRoot, 0)
                  firetouchinterest(part, targetRoot, 1)
               end
            end
         end
      end
   end
end

-- Dedicated Anti-Aim Engine
RunService.RenderStepped:Connect(function()
   if not antiAimActive then return end
   local char = LocalPlayer.Character
   if not char or not char:FindFirstChild("HumanoidRootPart") then return end
   local rootPart = char.HumanoidRootPart
   
   local currentPos = rootPart.Position
   local randomAngle = math.rad(math.random(0, 360))
   rootPart.CFrame = CFrame.new(currentPos) * CFrame.Angles(0, randomAngle, 0)
end)

-- Main 100% Hit Melee Aura State Machine Loop (Pauses instantly on toggle off or target change)
task.spawn(function()
   while true do
      task.wait(0.05)
      if rageActive then
         local char = LocalPlayer.Character
         if char and char:FindFirstChild("HumanoidRootPart") then
            local rootPart = char.HumanoidRootPart
            local currentTrackedTarget = selectedTargetSelection
            local targetRoot = getTargetRoot(rootPart)

            if targetRoot then
               local attackStartTime = tick()
               
               -- ATTACK PHASE
               while rageActive and selectedTargetSelection == currentTrackedTarget and (tick() - attackStartTime) < attackSeconds do
                  local liveTargetRoot = getTargetRoot(rootPart)
                  if not liveTargetRoot then break end
                  
                  local targetPosRef = liveTargetRoot.Position
                  rootPart.CFrame = CFrame.new(targetPosRef + Vector3.new(0, 0, 1.5), targetPosRef)
                  forceHitTarget(liveTargetRoot)
                  
                  local msg = string.format("LOLY [ATTACKING] (%ds / %.1fs)", attackSeconds, (tick() - attackStartTime))
                  StatusLabel:Set("Status: " .. msg)
                  statusText.Text = msg
                  task.wait(0.02)
               end

               -- If toggled off or target changed, immediately pause / break loop
               if not rageActive or selectedTargetSelection ~= currentTrackedTarget then
                  StatusLabel:Set("Status: [IDLE] Target Changed / Paused")
                  statusText.Text = "LOLY [IDLE] - Paused"
                  task.wait(0.2)
                  continue
               end

               -- HIDE PHASE
               local safeVoidPos = getSafestVoidPosition(targetRoot.Position)
               rootPart.CFrame = CFrame.new(safeVoidPos)
               local hideStartTime = tick()

               while rageActive and selectedTargetSelection == currentTrackedTarget and (tick() - hideStartTime) < hideSeconds do
                  rootPart.CFrame = CFrame.new(safeVoidPos)
                  
                  local msg = string.format("LOLY [HIDING] (%ds / %.1fs)", hideSeconds, (tick() - hideStartTime))
                  StatusLabel:Set("Status: " .. msg)
                  statusText.Text = msg
                  task.wait(0.05)
               end

               if not rageActive or selectedTargetSelection ~= currentTrackedTarget then
                  StatusLabel:Set("Status: [IDLE] Target Changed / Paused")
                  statusText.Text = "LOLY [IDLE] - Paused"
                  task.wait(0.2)
               end
            else
               StatusLabel:Set("Status: [IDLE] Waiting for Target...")
               statusText.Text = "LOLY [IDLE] - Waiting for Target..."
               task.wait(0.5)
            end
         end
      else
         StatusLabel:Set("Status: [IDLE] Paused")
         statusText.Text = "LOLY [IDLE] - Paused"
         task.wait(0.5)
      end
   end
end)
