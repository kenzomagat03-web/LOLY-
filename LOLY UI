   Name = "Target Selector (Username / Nickname)",
   Options = getPlayerList(),
   CurrentOption = {"None (Nearest)"},
   MultiSelection = false,
   Flag = "PlayerDropdown",
   Callback = function(Option)
      local newTarget = ""
      if type(Option) == "table" then
         newTarget = Option[1] or "None (Nearest)"
      elseif type(Option) == "string" then
         newTarget = Option
      end
      
      -- If the target selection changes while active, instantly reset/pause to re-evaluate smoothly
      if selectedTargetSelection ~= newTarget then
         selectedTargetSelection = newTarget
      end
   end,
})

