-- Main 100% Hit Melee Aura State Machine Loop
task.spawn(function()
   while true do
      task.wait(0.05)
      if rageActive then
         local char = LocalPlayer.Character
         local hum = char and char:FindFirstChildOfClass("Humanoid")
         if char and hum and hum.Health > 0 and char:FindFirstChild("HumanoidRootPart") then
            local rootPart = char.HumanoidRootPart
            local currentTrackedTarget = selectedTargetSelection
            local targetRoot = getTargetRoot(rootPart)

            if targetRoot then
               local attackStartTime = tick()
               
               -- ATTACK PHASE
               while rageActive and hum.Health > 0 and selectedTargetSelection == currentTrackedTarget and (tick() - attackStartTime) < attackSeconds do
                  local liveTargetRoot = getTargetRoot(rootPart)
                  if not liveTargetRoot then break end
                  
                  local targetPosRef = liveTargetRoot.Position
                  rootPart.CFrame = CFrame.new(targetPosRef + Vector3.new(0, 0, 1.5), targetPosRef)
                  forceHitTarget(liveTargetRoot)
                  
                  local msg = string.format("LOLY [ATTACKING] (%ds / %.1fs)", attackSeconds, (tick() - attackStartTime))
                  StatusLabel:Set("Status: " .. msg)
                  statusText.Text = msg
                  task.wait(0.02)
               end

               if not rageActive or hum.Health <= 0 or selectedTargetSelection ~= currentTrackedTarget then
                  StatusLabel:Set("Status: [IDLE] Paused")
                  statusText.Text = "LOLY [IDLE] - Paused"
                  task.wait(0.2)
                  continue
               end

               -- VOID HIDE PHASE (Teleports to -50,000 Y-level and locks velocity/assembly linear velocity to avoid damage triggers)
               local hidePos = getVoid50kHidePosition(targetRoot.Position)
               rootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
               rootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
               rootPart.CFrame = CFrame.new(hidePos)
               local hideStartTime = tick()

               while rageActive and hum.Health > 0 and selectedTargetSelection == currentTrackedTarget and (tick() - hideStartTime) < hideSeconds do
                  local liveTarget = getTargetRoot(rootPart)
                  if liveTarget then
                     hidePos = getVoid50kHidePosition(liveTarget.Position)
                  end
                  rootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                  rootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                  rootPart.CFrame = CFrame.new(hidePos)
                  
                  local msg = string.format("LOLY [VOID HIDE -50K] (%ds / %.1fs)", hideSeconds, (tick() - hideStartTime))
                  StatusLabel:Set("Status: " .. msg)
                  statusText.Text = msg
                  task.wait(0.05)
               end

               if not rageActive or hum.Health <= 0 or selectedTargetSelection ~= currentTrackedTarget then
                  StatusLabel:Set("Status: [IDLE] Paused")
                  statusText.Text = "LOLY [IDLE] - Paused"
                  task.wait(0.2)
               end
            else
               StatusLabel:Set("Status: [IDLE] Waiting for Target...")
               statusText.Text = "LOLY [IDLE] - Waiting for Target..."
               task.wait(0.5)
            end
         end
      else
         StatusLabel:Set("Status: [IDLE] Paused")
         statusText.Text = "LOLY [IDLE] - Paused"
         task.wait(0.5)
      end
   end
end)
