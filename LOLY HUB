-- Build Player List Table dynamically
local function getPlayerList()
   local list = {"None (Nearest)"}
   for _, p in ipairs(Players:GetPlayers()) do
      if p ~= LocalPlayer then
         local displayText = string.format("%s (%s)", p.Name, p.DisplayName)
         table.insert(list, displayText)
      end
   end
   return list
end

