-- Helper: Get Target RootPart securely
local function getTargetRoot(myRoot)
   if selectedTargetSelection and selectedTargetSelection ~= "None (Nearest)" then
      for _, p in ipairs(Players:GetPlayers()) do
         if p ~= LocalPlayer then
            local formattedName = string.format("%s (%s)", p.Name, p.DisplayName)
            if formattedName == selectedTargetSelection or p.Name == selectedTargetSelection then
               if p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                  local hum = p.Character:FindFirstChild("Humanoid")
                  if hum and hum.Health > 0 then
                     return p.Character.HumanoidRootPart
                  end
               end
               return nil
            end
         end
      end
      return nil
   end

   -- Fallback: Nearest Player
   local nearestDist = math.huge
   local bestRoot = nil
   for _, p in ipairs(Players:GetPlayers()) do
      if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
         local hum = p.Character:FindFirstChild("Humanoid")
         if hum and hum.Health > 0 then
            local dist = (myRoot.Position - p.Character.HumanoidRootPart.Position).Magnitude
            if dist < nearestDist then
               nearestDist = dist
               bestRoot = p.Character.HumanoidRootPart
            end
         end
      end
   end
   return bestRoot
end

-- FIXED: Sets Void Hide Y-Level directly to -50000 with target's X and Z coordinates, and instantly zeroing velocities to prevent fall momentum bugs
local function getVoid50kHidePosition(targetRootPos)
   return Vector3.new(targetRootPos.X, -50000, targetRootPos.Z)
end

-- Helper: Force 100% Hit Connection
local function forceHitTarget(targetRoot)
   if not targetRoot or not LocalPlayer.Character then return end
   local myChar = LocalPlayer.Character
   
   for _, tool in ipairs(myChar:GetChildren()) do
      if tool:IsA("Tool") then
         tool:Activate()
         for _, part in ipairs(tool:GetDescendants()) do
            if part:IsA("BasePart") then
               part.CFrame = targetRoot.CFrame
               if firetouchinterest then
                  firetouchinterest(part, targetRoot, 0)
                  firetouchinterest(part, targetRoot, 1)
               end
            end
         end
      end
   end
end

-- Dedicated Anti-Aim Engine
RunService.RenderStepped:Connect(function()
   if not antiAimActive then return end
   local char = LocalPlayer.Character
   if not char or not char:FindFirstChild("HumanoidRootPart") then return end
   local rootPart = char.HumanoidRootPart
   
   local currentPos = rootPart.Position
   local randomAngle = math.rad(math.random(0, 360))
   rootPart.CFrame = CFrame.new(currentPos) * CFrame.Angles(0, randomAngle, 0)
end)

