            c:Destroy()
        end
    end
    local skins = SKINS[State.SelectedWeapon] or {}
    for i, skin in ipairs(skins) do
        local card = Instance.new("Frame")
        card.Size             = UDim2.new(1, 0, 0, 52)
        card.BackgroundColor3 = CONFIG.CardColor
        card.BorderSizePixel  = 0
        card.LayoutOrder      = i
        MakeCorner(card, 8)
        card.Parent = SkinPage

        local skinLabel = Instance.new("TextLabel")
        skinLabel.Size               = UDim2.new(1, -60, 1, 0)
        skinLabel.Position           = UDim2.new(0, 12, 0, 0)
        skinLabel.BackgroundTransparency = 1
        skinLabel.Text               = skin
        skinLabel.TextColor3         = CONFIG.TextColor
        skinLabel.Font               = Enum.Font.GothamSemiBold
        skinLabel.TextSize           = 13
        skinLabel.TextXAlignment     = Enum.TextXAlignment.Left
        skinLabel.Parent = card

        local applyBtn = Instance.new("TextButton")
        applyBtn.Size             = UDim2.new(0, 70, 0, 30)
        applyBtn.Position         = UDim2.new(1, -78, 0.5, -15)
        applyBtn.BackgroundColor3 = (State.AppliedSkins[State.SelectedWeapon] == skin)
                                     and CONFIG.SuccessColor or CONFIG.AccentColor
        applyBtn.Text             = (State.AppliedSkins[State.SelectedWeapon] == skin) and "✓ On" or "Apply"
        applyBtn.TextSize         = 12
        applyBtn.Font             = Enum.Font.GothamBold
        applyBtn.TextColor3       = Color3.new(1,1,1)
        applyBtn.BorderSizePixel  = 0
        applyBtn.AutoButtonColor  = false
        MakeCorner(applyBtn, 6)
        applyBtn.Parent = card

        applyBtn.MouseButton1Click:Connect(function()
            ApplySkin(State.SelectedWeapon, skin)
            RefreshSkinList()
        end)
    end
