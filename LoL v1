    pad.PaddingLeft   = UDim.new(0, 12)
    pad.PaddingRight  = UDim.new(0, 12)
    pad.PaddingTop    = UDim.new(0, 10)
    pad.PaddingBottom = UDim.new(0, 10)
    pad.Parent = card

    local t = MakeLabel(card, title, 13, CONFIG.AccentColor, Enum.Font.GothamBold)
    t.LayoutOrder = 1
    local b = MakeLabel(card, body, 12, CONFIG.MutedColor, Enum.Font.Gotham)
    b.LayoutOrder  = 2
    b.TextWrapped  = true
    b.AutomaticSize = Enum.AutomaticSize.Y
    b.Size          = UDim2.new(1, 0, 0, 0)
    return card
end

