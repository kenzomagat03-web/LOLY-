-- ============================================================
--  TOGGLE VISIBILITY
-- ============================================================
local function ToggleGUI()
    State.GUIOpen = not State.GUIOpen
    if State.GUIOpen then
        -- OPEN: scale up from zero with a spring bounce
        Panel.Size    = UDim2.new(0, 320, 0, 0)
        Panel.Visible = true
        Tween(Panel, {Size = UDim2.new(0, 320, 0, 520), BackgroundTransparency = 0},
            0.28, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
        -- Toggle button turns into X
        Tween(ToggleBtn, {BackgroundColor3 = CONFIG.DangerColor}, 0.18)
        ToggleBtn.Text = "✕"
    else
        -- CLOSE: shrink down smoothly
        Tween(Panel, {Size = UDim2.new(0, 320, 0, 0)},
            0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
        task.delay(0.22, function()
            Panel.Visible = false
        end)
        -- Toggle button goes back to hamburger
        Tween(ToggleBtn, {BackgroundColor3 = CONFIG.AccentColor}, 0.18)
        ToggleBtn.Text = "☰"
    end
end

ToggleBtn.MouseButton1Click:Connect(ToggleGUI)
CloseBtn.MouseButton1Click:Connect(ToggleGUI)

UserInputService.InputBegan:Connect(function(inp, gpe)
    if gpe then return end
    if inp.KeyCode == CONFIG.ToggleKey then
        ToggleGUI()
    end
end)

