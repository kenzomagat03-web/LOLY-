local function Tween(obj, props, t, style, dir)
    local info = TweenInfo.new(t or 0.18, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out)
    TweenService:Create(obj, info, props):Play()
end

local function MakeCorner(parent, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius or 8)
    c.Parent = parent
    return c
end

local function MakeLabel(parent, text, size, color, font)
    local l = Instance.new("TextLabel")
    l.BackgroundTransparency = 1
    l.Text = text
    l.TextSize = size or 14
    l.TextColor3 = color or CONFIG.TextColor
    l.Font = font or Enum.Font.GothamSemiBold
    l.TextXAlignment = Enum.TextXAlignment.Left
    l.Size = UDim2.new(1, 0, 0, size and size + 6 or 20)
    l.Parent = parent
    return l
end

local function MakeButton(parent, text, bgColor, txtColor)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 38)
    btn.BackgroundColor3 = bgColor or CONFIG.AccentColor
    btn.TextColor3 = txtColor or Color3.fromRGB(255,255,255)
    btn.Text = text
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 13
    btn.AutoButtonColor = false
    btn.BorderSizePixel = 0
    MakeCorner(btn, 8)
    btn.MouseEnter:Connect(function()
        Tween(btn, {BackgroundColor3 = btn.BackgroundColor3:Lerp(Color3.fromRGB(255,255,255), 0.12)})
    end)
    btn.MouseLeave:Connect(function()
        Tween(btn, {BackgroundColor3 = bgColor or CONFIG.AccentColor})
    end)
    btn.Parent = parent
    return btn
end

-- ============================================================
--  APPLY SKIN (client-side only – visual rename / texture swap)
-- ============================================================
local function ApplySkin(weapon, skin)
    State.AppliedSkins[weapon] = skin

    -- Walk the character/backpack and rename matching tools cosmetically
    local function processModel(model)
        if not model then return end
        for _, obj in ipairs(model:GetDescendants()) do
            -- Try to match by weapon category name
            if obj:IsA("Tool") then
                local lname = obj.Name:lower()
                if lname:find(weapon:lower()) or
                   (weapon == "AssaultRifle" and (lname:find("rifle") or lname:find("ar"))) or
                   (weapon == "Melee"        and (lname:find("sword") or lname:find("knife") or lname:find("axe") or lname:find("dagger") or lname:find("chainsaw"))) then
                    -- Cosmetic tag only
                    local tag = obj:FindFirstChild("_RivalsScriptSkinTag")
                    if not tag then
                        tag = Instance.new("StringValue")
                        tag.Name = "_RivalsScriptSkinTag"
                        tag.Parent = obj
                    end
                    tag.Value = skin
                end
            end
        end
    end

    processModel(LocalPlayer.Character)
    processModel(LocalPlayer.Backpack)
    return true
end

-- ============================================================
--  UNLOCK ALL  (client-side simulation: marks owned flag)
-- ============================================================
local function ToggleUnlockAll(enabled)
    State.UnlockAll = enabled

    -- Attempt to set local ownership flags if the game exposes them
    local success = pcall(function()
        local data = LocalPlayer:FindFirstChild("PlayerData") or
                     LocalPlayer:FindFirstChild("Data") or
                     LocalPlayer:FindFirstChild("leaderstats")
        if data then
            for _, v in ipairs(data:GetDescendants()) do
                if v:IsA("BoolValue") and
                   (v.Name:lower():find("own") or v.Name:lower():find("unlock") or v.Name:lower():find("have")) then
                    v.Value = enabled
                end
                if v:IsA("NumberValue") and
                   (v.Name:lower():find("coin") or v.Name:lower():find("credit") or v.Name:lower():find("key")) then
                    if enabled then v.Value = v.Value + 999999 end
                end
            end
        end
    end)

    return success
end

