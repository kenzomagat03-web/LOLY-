-- Simple Fly + Noclip Script
-- Controls: F = Fly | G = Noclip | Arrow Keys or WASD to move

local player = game.Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local humanoid = character:WaitForChild("Humanoid")
local rootPart = character:WaitForChild("HumanoidRootPart")

-- Variables
local flying = false
local noclip = false
local speed = 50
local bodyVel = nil
local bodyGyro = nil
local connection = nil

-- Create GUI
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "FlyNoclip"
screenGui.Parent = player:WaitForChild("PlayerGui")
screenGui.ResetOnSpawn = false

-- Main Frame
local frame = Instance.new("Frame")
frame.Size = UDim2.new(0, 200, 0, 150)
frame.Position = UDim2.new(0, 10, 0, 10)
frame.BackgroundColor3 = Color3.fromRGB(25, 25, 35)
frame.BorderSizePixel = 2
frame.BorderColor3 = Color3.fromRGB(100, 150, 255)
frame.Active = true
frame.Draggable = true
frame.Parent = screenGui

-- Title
local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0, 30)
title.Text = "✈️ Fly + Noclip"
title.TextColor3 = Color3.fromRGB(255, 255, 255)
title.BackgroundTransparency = 1
title.Font = Enum.Font.GothamBold
title.TextScaled = true
title.Parent = frame

-- Fly Button
local flyBtn = Instance.new("TextButton")
flyBtn.Size = UDim2.new(0, 85, 0, 30)
flyBtn.Position = UDim2.new(0, 10, 0, 40)
flyBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 255)
flyBtn.Text = "Fly: OFF"
flyBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
flyBtn.Font = Enum.Font.GothamBold
flyBtn.TextScaled = true
flyBtn.Parent = frame

-- Noclip Button
local noclipBtn = Instance.new("TextButton")
noclipBtn.Size = UDim2.new(0, 85, 0, 30)
noclipBtn.Position = UDim2.new(0, 105, 0, 40)
noclipBtn.BackgroundColor3 = Color3.fromRGB(0, 200, 0)
noclipBtn.Text = "Noclip: OFF"
noclipBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
noclipBtn.Font = Enum.Font.GothamBold
noclipBtn.TextScaled = true
noclipBtn.Parent = frame

-- Speed Slider
local speedLabel = Instance.new("TextLabel")
speedLabel.Size = UDim2.new(1, 0, 0, 20)
speedLabel.Position = UDim2.new(0, 0, 0, 80)
speedLabel.Text = "Speed: 50"
speedLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
speedLabel.BackgroundTransparency = 1
speedLabel.Font = Enum.Font.Gotham
speedLabel.TextScaled = true
speedLabel.Parent = frame

local slider = Instance.new("Frame")
slider.Size = UDim2.new(0, 180, 0, 5)
slider.Position = UDim2.new(0, 10, 0, 105)
slider.BackgroundColor3 = Color3.fromRGB(60, 60, 70)
slider.BorderSizePixel = 0
slider.Parent = frame

local fill = Instance.new("Frame")
fill.Size = UDim2.new(0.25, 0, 1, 0)
fill.BackgroundColor3 = Color3.fromRGB(0, 150, 255)
fill.BorderSizePixel = 0
fill.Parent = slider

local dragBtn = Instance.new("TextButton")
dragBtn.Size = UDim2.new(0, 14, 0, 14)
dragBtn.Position = UDim2.new(0.25, -7, 0, -4.5)
dragBtn.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
dragBtn.BorderSizePixel = 2
dragBtn.BorderColor3 = Color3.fromRGB(0, 150, 255)
dragBtn.Text = ""
dragBtn.Parent = slider

-- Close Button
local closeBtn = Instance.new("TextButton")
closeBtn.Size = UDim2.new(0, 20, 0, 20)
closeBtn.Position = UDim2.new(1, -25, 0, 5)
closeBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
closeBtn.Text = "X"
closeBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
closeBtn.Font = Enum.Font.GothamBold
closeBtn.TextScaled = true
closeBtn.Parent = frame

-- Functions
local function toggleFly()
    flying = not flying
    flyBtn.Text = "Fly: " .. (flying and "ON" or "OFF")
    flyBtn.BackgroundColor3 = flying and Color3.fromRGB(255, 200, 0) or Color3.fromRGB(0, 150, 255)
    
    if flying then
        bodyVel = Instance.new("BodyVelocity")
        bodyVel.MaxForce = Vector3.new(1e9, 1e9, 1e9)
        bodyVel.Parent = rootPart
        
        bodyGyro = Instance.new("BodyGyro")
        bodyGyro.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
        bodyGyro.CFrame = rootPart.CFrame
        bodyGyro.Parent = rootPart
        
        humanoid.PlatformStand = true
        
        connection = game:GetService("RunService").Heartbeat:Connect(function()
            if not flying then return end
            local move = Vector3.new()
            local cam = workspace.CurrentCamera
            
            if game:GetService("UserInputService"):IsKeyDown(Enum.KeyCode.W) then move = move + cam.CFrame.LookVector end
            if game:GetService("UserInputService"):IsKeyDown(Enum.KeyCode.S) then move = move - cam.CFrame.LookVector end
            if game:GetService("UserInputService"):IsKeyDown(Enum.KeyCode.A) then move = move - cam.CFrame.RightVector end
            if game:GetService("UserInputService"):IsKeyDown(Enum.KeyCode.D) then move = move + cam.CFrame.RightVector end
            if game:GetService("UserInputService"):IsKeyDown(Enum.KeyCode.Space) then move = move + Vector3.new(0, 1, 0) end
            if game:GetService("UserInputService"):IsKeyDown(Enum.KeyCode.LeftShift) then move = move - Vector3.new(0, 1, 0) end
            
            if move.Magnitude > 0 then move = move.Unit end
            bodyVel.Velocity = move * speed
            bodyGyro.CFrame = cam.CFrame
        end)
    else
        if bodyVel then bodyVel:Destroy() end
        if bodyGyro then bodyGyro:Destroy() end
        if connection then connection:Disconnect() end
        humanoid.PlatformStand = false
    end
end

local function toggleNoclip()
    noclip = not noclip
    noclipBtn.Text = "Noclip: " .. (noclip and "ON" or "OFF")
    noclipBtn.BackgroundColor3 = noclip and Color3.fromRGB(255, 200, 0) or Color3.fromRGB(0, 200, 0)
    
    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = not noclip
        end
    end
end

-- Button Connections
flyBtn.MouseButton1Click:Connect(toggleFly)
noclipBtn.MouseButton1Click:Connect(toggleNoclip)

-- Slider
local dragging = false
local function updateSpeed(input)
    local width = slider.AbsoluteSize.X
    local pos = input.Position.X - slider.AbsolutePosition.X
    local percent = math.clamp(pos / width, 0, 1)
    speed = math.round(10 + percent * 190)
    fill.Size = UDim2.new(percent, 0, 1, 0)
    dragBtn.Position = UDim2.new(percent, -7, 0, -4.5)
    speedLabel.Text = "Speed: " .. speed
end

dragBtn.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        updateSpeed(input)
    end
end)

dragBtn.InputChanged:Connect(function(input)
    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        updateSpeed(input)
    end
end)

dragBtn.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = false
    end
end)

slider.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        updateSpeed(input)
    end
end)

-- Close
closeBtn.MouseButton1Click:Connect(function()
    if flying then toggleFly() end
    if noclip then toggleNoclip() end
    screenGui:Destroy()
end)

-- Keybinds
game:GetService("UserInputService").InputBegan:Connect(function(input, processed)
    if processed then return end
    if input.KeyCode == Enum.KeyCode.F then toggleFly() end
    if input.KeyCode == Enum.KeyCode.G then toggleNoclip() end
end)

-- Respawn
player.CharacterAdded:Connect(function(newChar)
    character = newChar
    humanoid = character:WaitForChild("Humanoid")
    rootPart = character:WaitForChild("HumanoidRootPart")
    flying = false
    noclip = false
    flyBtn.Text = "Fly: OFF"
    flyBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 255)
    noclipBtn.Text = "Noclip: OFF"
    noclipBtn.BackgroundColor3 = Color3.fromRGB(0, 200, 0)
    if bodyVel then bodyVel:Destroy() end
    if bodyGyro then bodyGyro:Destroy() end
    if connection then connection:Disconnect() end
    humanoid.PlatformStand = false
end)

-- Notification
game:GetService("StarterGui"):SetCore("SendNotification", {
    Title = "Fly + Noclip Loaded",
    Text = "Press F to Fly | G for Noclip",
    Duration = 3
})

print("Fly + Noclip loaded successfully!")
